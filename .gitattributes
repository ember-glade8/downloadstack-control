# 统一行尾，防止 Windows/Linux 互相污染
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.sh    text eol=lf
*.py    text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.txt   text eol=lf
*.html  text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.desktop text eol=lf

# 二进制（必须在这里声明，否则会被当成文本改行尾而损坏）
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.cbz   binary
*.epub  binary
*.zip   binary
*.rar   binary
*.tar.gz binary
*.exe   binary
*.woff  binary
*.woff2 binary
