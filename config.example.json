{
  "_readme": "参考配置模板，不需要手动改名。面板首次启动会按自身位置自动生成本地 config.json（已加入 .gitignore，绝不入库）。<ROOT> 与 <DOWNLOADS> 会自动替换为本机实际目录。",
  "aria2": {
    "host": "127.0.0.1",
    "port": 6800,
    "exe": "<ROOT>/aria2/aria2c.exe",
    "conf": "<ROOT>/aria2/aria2.conf",
    "secret": "<ROOT>/aria2/rpc-secret.txt",
    "logdir": "<ROOT>/logs"
  },
  "qbit": {
    "host": "127.0.0.1",
    "port": 8080,
    "user": "admin",
    "pass": "",
    "config_dir": "<ROOT>/qBittorrent/profile/qBittorrent/config",
    "save_dir": "<DOWNLOADS>/qBittorrent",
    "exe_dir": "<ROOT>/qBittorrent"
  },
  "yt": {
    "bat": "",
    "bat2": "",
    "ini": "",
    "output": "<DOWNLOADS>/yt-dlp",
    "cookies": "auto",
    "cookies_file": ""
  },
  "ariang": {
    "port": 16800,
    "dir": "<ROOT>/ariaNg",
    "script": "<ROOT>/start_ariang.cmd"
  },
  "scripts": {
    "start": "<ROOT>/start_aria2.cmd",
    "stop": "<ROOT>/stop_aria2.cmd",
    "qbit": "<ROOT>/start_qbit.cmd"
  },
  "ui": {
    "theme": "dark",
    "autostart_panel": false,
    "autostart_aria2": false,
    "upscale": false
  },
  "paths": {
    "downloads": "<DOWNLOADS>",
    "music": "<DOWNLOADS>/music",
    "voice": "<DOWNLOADS>/voice-clone",
    "aigc": "<DOWNLOADS>/ai-studio"
  },
  "voice": {
    "api_url": "http://127.0.0.1:9880"
  },
  "comfyui": {
    "enabled": false,
    "owner_only": true,
    "url": "http://127.0.0.1:8188",
    "root": "",
    "start_bat": "",
    "custom_mode": "comfyui",
    "custom_url": "",
    "custom_api_key": "",
    "custom_model": "",
    "custom_workflow_json": ""
  },
  "codex": {
    "base_url": "",
    "api_key": "",
    "model": "",
    "api_style": "auto"
  }
